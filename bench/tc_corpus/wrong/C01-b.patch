+def _github_line_with_colons(colwidths, colaligns):
+    """Return a horizontal line for the `github` format, marking numeric
+    columns as right-aligned."""
+    if not colaligns:
+        colaligns = [""] * len(colwidths)
+    segments = []
+    for a, w in zip(colaligns, colwidths):
+        if a in ("right", "decimal"):
+            segments.append(("-" * (w - 1)) + ":")
+        else:
+            segments.append("-" * w)
+    return "|" + "|".join(segments) + "|"
+
